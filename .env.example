# ============================================================
#  Настройки бота и сервера. Скопируйте в .env:
#     cp .env.example .env
# ============================================================

# --- ОБЯЗАТЕЛЬНО ---------------------------------------
# Токен бота от @BotFather
BOT_TOKEN=

# Ваш Telegram ID (узнать: команда /id в боте или @userinfobot).
# Несколько — через запятую. Если пусто — первый, кто нажмёт /start, станет владельцем.
ADMIN_IDS=
OPEN_CLAIM=1

# --- СЕРВЕР MINECRAFT PE 1.1.x -----------------------
SERVER_PORT=19132
SERVER_PORT_ALT=19133
SERVER_MOTD=Genisys 1.1.5 Server
MAX_PLAYERS=20
# 0 выживание, 1 креатив, 2 приключение, 3 наблюдатель
GAMEMODE=0
# 0 мирная, 1 легко, 2 норма, 3 сложно
DIFFICULTY=2
LEVEL_NAME=world
LEVEL_SEED=
LEVEL_TYPE=DEFAULT
WHITELIST=off
PVP=on
VIEW_DISTANCE=8
# Язык ядра Genisys: rus или eng
SERVER_LANGUAGE=rus

# --- PHP 7.0 / 7.1 / 7.2 (автозагрузка) ----------------
PHP_TARGET_VERSION=7.2
# Прямая ссылка на tar.gz с бинарниками (если зеркала недоступны)
PHP_BINARY_URL=
# Путь к уже установленному php с pthreads
PHP_BINARY_PATH=
# Сборка из исходников, если готовые не скачались (долго: 20-40 мин)
ALLOW_PHP_BUILD=1

# --- АВТОМАТИЗАЦИЯ ------------------------------------
AUTO_INSTALL=1
AUTO_START=1
CONSOLE_STREAM=0
LOG_LINES=400
BACKUP_MAX_MB=45

# --- АДРЕСА -----------------------------------------------
# Свой домен / DDNS (покажется в /ip)
PUBLIC_HOST=
SHOW_PUBLIC_IP=1
# Временный публичный адрес без проброса портов (playit.gg)
ENABLE_TUNNEL=0
PLAYIT_SECRET=

# --- ПРОЧЕЕ ----------------------------------------------
TZ=Asia/Chita

# ---------------------------------------------------------------------------
# PHP в 2026 году (важно)
# ---------------------------------------------------------------------------
# Готовых бинарников PHP 7 больше не существует: репозиторий
# pmmp/PHP-Binaries заархивирован (в релизах только PHP 8.x для PM4/PM5),
# jenkins.pmmp.io отдаёт HTML-заглушку, ci.pmmp.io не резолвится.
# Поэтому PHP 7.2 (ZTS + pthreads) собирается из исходников один раз —
# на этапе docker build (образ debian:buster внутри Dockerfile).

# Версия PHP для сборки образа (7.2.34 — максимум для pthreads 3.2.0)
PHP_BUILD_VERSION=7.2.34
PTHREADS_VERSION=3.2.0

# Путь к готовой сборке внутри образа (менять не нужно)
PHP_PREBUILT_DIR=/opt/php7

# Своя прямая ссылка на tar.gz с PHP 7.x (если где-то есть своё зеркало)
# PHP_BINARY_URL=
# Готовый бинарник на диске
# PHP_BINARY_PATH=
# Разрешить сборку из исходников при команде /reinstall
ALLOW_PHP_BUILD=1
